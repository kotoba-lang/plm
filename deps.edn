{:paths ["src" "resources"]
 ;; ws-valueflo-vocabulary supplies the Valueflows action behaviour table, which
 ;; decides WHICH inventory register a movement touches (kotoba.plm.registers).
 ;; A git dep rather than a copy: re-deriving that table here is how one copy
 ;; gets fixed and the other does not.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.4"}
        io.github.kotoba-lang/ws-valueflo-vocabulary
        {:git/url "https://github.com/kotoba-lang/ws-valueflo-vocabulary.git"
         :git/sha "eea3c6bb3ce84a40d7e6f72985d634a5b1c342c9"}}
 :aliases
 {;; GitHub Pages workbench build (shadow-cljs :app) — UI deps isolated here
  ;; so library consumers don't inherit reagent/re-frame/shadow-cljs.
  :cljs {:extra-deps {reagent/reagent {:mvn/version "1.3.0"}
                      re-frame/re-frame {:mvn/version "1.4.3"}
                      thheller/shadow-cljs {:mvn/version "3.4.11"}}}

  ;; opt-in Datomic Local dev/test backend (kotoba.plm.store-datomic)
  :datomic {:extra-deps {com.datomic/local {:mvn/version "1.0.291"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      com.datomic/local {:mvn/version "1.0.291"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
